# Настройки локального стенда.
#
# docker compose читает этот файл сам (он подключён как env_file сервисов `db` и `api`),
# поэтому `docker compose up -d --build` работает «из коробки».
# Для своего стенда скопируйте файл в `.env` и задайте свои значения —
# `.env` подключается вторым и переопределяет всё, что здесь написано.
#
#   cp .env.example .env
#
# Ни одно из этих значений не должно использоваться на реальном стенде.

# --- PostgreSQL ---
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
POSTGRES_DB=crm
# Если меняете POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB, поправьте и строку ниже.
DATABASE_URL=postgresql+psycopg://crm:crm@db:5432/crm

# --- Сессии ---
# Секрет подписи JWT. На реальном стенде обязательно задайте своё случайное значение,
# иначе токены можно подделать на любом стенде с этим файлом.
JWT_SECRET=local-stand-only-secret-change-me-32-chars
# Срок жизни сессии в днях.
JWT_EXPIRE_DAYS=7
# Cookie с токеном отдаётся только по https, если здесь true.
SESSION_COOKIE_SECURE=false

# Ссылка активации живёт столько часов.
ACTIVATION_TOKEN_TTL_HOURS=24
# Абсолютный адрес фронта: из него собирается ссылка в письме активации.
FRONTEND_BASE_URL=http://localhost:8080

# --- Почта (письмо активации кабинета) ---
SMTP_HOST=smtp.timeweb.ru
SMTP_PORT=465
SMTP_USER=no-reply@xn--80adr6bcdm2a.xn--p1ai
# Должен совпадать с SMTP_USER, иначе почтовик завернёт письмо.
SMTP_FROM=no-reply@xn--80adr6bcdm2a.xn--p1ai
# Пароль ящика. Здесь его нет и быть не должно: на стенде человек задаёт своё
# значение в .env. Пока пароль пуст, письма не уходят, а регистрация отвечает
# `activation_email_sent: false` — сама регистрация при этом работает.
SMTP_PASSWORD=
SMTP_USE_TLS=true

# --- DaData (реквизиты организации по ИНН) ---
# Токен подстановки (suggestions) выдаётся в личном кабинете DaData:
# https://dadata.ru/profile/#info — раздел «API-ключи».
# Здесь указывается ТОЛЬКО сам токен (40 hex-символов), без имени переменной:
# строка вида `DADATA_API_KEY = <токен>` приведёт к ответу
# `403 Feature 'SUGGESTIONS' disabled for token 'DADATA_API_KEY'`.
# Пока ключ пуст, поиск отвечает «сервис недоступен», а всё остальное работает.
DADATA_API_KEY=

# --- Telegram (уведомления из личного кабинета) ---
# Бот один на весь проект, регистрирует его владелец продукта в @BotFather.
# Пока TELEGRAM_BOT_TOKEN пуст, всё остальное приложение работает как раньше:
# кабинет отвечает 503 на подключение, бот пишет в лог и выходит до сети.
TELEGRAM_BOT_TOKEN=
# Имя бота без «@»: из него сервер собирает ссылку https://t.me/<имя>?start=<код>.
# Фронт имени бота не знает — оно приходит с сервера.
TELEGRAM_BOT_USERNAME=
# Свой случайный секрет: им бот доказывает CRM, что он бот (заголовок X-Bot-Token).
# Это НЕ токен BotFather и НЕ значение из личного кабинета Telegram.
TELEGRAM_SERVICE_TOKEN=
# Адрес Bot API. Меняется только для тестов и локальных заглушек.
TELEGRAM_API_BASE_URL=https://api.telegram.org
# Срок жизни кода привязки из кабинета, в минутах.
TELEGRAM_LINK_TTL_MINUTES=15
# Пауза между опросами Bot API в боте, в секундах.
TELEGRAM_POLL_INTERVAL_SECONDS=3
# Потолок одного запроса к Bot API, в секундах.
TELEGRAM_REQUEST_TIMEOUT_SECONDS=10
# Куда бот ходит за готовыми уведомлениями: внутренний адрес api в compose.
# Публичного адреса у бота нет, вебхук не используется.
TELEGRAM_CRM_API_URL=http://api:8000

# --- Файловое хранилище S3 (исходные файлы импорта) ---
# Единый механизм хранения (`app/backend/app/storage.py`) использует S3, когда
# заданы endpoint, бакет и ключи активной среды (S3_ENV=test|prod). Пока ключи
# пусты — работает локальный каталог `app/backend/uploads`, а в compose он же
# лежит в томе `uploads` (путь внутри образа — `/app/uploads`).
#
# Ключи кладутся ТОЛЬКО в `.env`: он в `.gitignore` и в репозиторий не
# попадает. Здесь держим имена переменных и пустые значения.
S3_ENDPOINT=https://s3.twcstorage.ru
# Имя бакета. Пусто — S3 выключен.
S3_BUCKET=
# test | prod — выбирает пару ключей и префикс в бакете.
S3_ENV=test
# Тестовая среда → префикс crm-agent-test
S3_ACCESS_KEY_TEST=
S3_SECRET_KEY_TEST=
S3_PREFIX_TEST=crm-agent-test
# Боевая среда → префикс crm-prod
S3_ACCESS_KEY_PROD=
S3_SECRET_KEY_PROD=
S3_PREFIX_PROD=crm-prod

# --- Порты стенда на хосте ---
FRONTEND_PORT=8080
API_PORT=8001

# --- HTTPS (профиль tls, см. docs/ssl.md) ---
# Домен, на который Caddy выпускает сертификат: только имя, без схемы, без www
# (www добавляет сам Caddyfile). Пусто — профиль tls не поднимется: это защита
# от запуска ACME без домена. На сервере значение задаётся в его .env.
SITE_DOMAIN=
# Почта для писем об истечении сертификата (ACME принимает только ASCII).
ACME_EMAIL=
# ACME-директория Let's Encrypt: боевая. Staging — только для первой проверки.
CADDY_ACME_CA=https://acme-v02.api.letsencrypt.org/directory

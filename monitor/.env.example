# Окружение стека мониторинга: копируется на сервер как monitor/.env.
#
#   cp monitor/.env.example monitor/.env
#
# monitor/.env в git не попадает (.gitignore, шаблон `.env`) и НЕ перезаписывается
# деплоем. Сам файл записывает .github/workflows/deploy-monitoring.yml при первом
# запуске: он же генерирует пароли. Руками править можно — деплой перезапишет
# только пустые/заглушечные значения.
#
# Запуск стека — только с явным окружением:
#   docker compose -f monitor/docker-compose.monitor.yml --env-file monitor/.env up -d --build
# Без `--env-file` compose подхватит корневой .env основного приложения (пароли
# базы, JWT_SECRET) — мониторингу они не нужны.
#
# Значения ниже — заглушки для сборки и стенда. На бою пароли генерируются.

# --- Сеть и адрес ---
# Сеть основного стека. На сервере — <COMPOSE_PROJECT_NAME>_default корневого
# docker-compose.yml (crm-dormitory_default). У стенда отдела имя проекта своё,
# поэтому переменная, а не константа: без неё мониторинг просто не увидит api.
APP_NETWORK=crm-dormitory_default
# Публичный адрес Grafana. Деплой пишет сюда monitor.<SITE_DOMAIN>; значение
# обязано совпадать с доменом сайта в caddy/Caddyfile, иначе Grafana отдаёт
# «origin not allowed» и не пускает в интерфейс.
MONITOR_HOST=monitor.dmv-crm.ru

# --- Доступ ---
# Логин и bcrypt-хеш пароля на входе в мониторинг. Проверяет их Caddy
# (блок `monitor.` в caddy/Caddyfile) до того, как запрос дойдёт до Grafana.
# Живая пара лежит в корневом .env основного стека: её читает compose и передаёт
# в контейнер caddy. Здесь она только зеркалируется деплоем — править эту копию
# руками бессмысленно, `--env-file monitor/.env` её всё равно не использует.
# Хеш — НЕ пароль: его печатает `caddy hash-password`. Пустой хеш недопустим —
# caddy с ним не стартует, поэтому здесь заглушка: bcrypt 60 случайных символов,
# пароль к которому не знает никто. Деплой заменяет её настоящей парой.
# `$$` — не опечатка: compose интерполирует `$` в значениях .env, и одиночный
# `$2a$14$` приезжает в контейнер обрезанным (`$2a$14.…`), так что верный пароль
# перестаёт подходить. Удвоение возвращает в контейнер исходные 60 символов.
MONITOR_BASIC_AUTH_USER=monitor
MONITOR_BASIC_AUTH_HASH=$$2a$$14$$nduRAFlYpbDebxcIGa2oveoXKJswEHWAV8vFTVWn.HXKmBjZADkmy

# --- Логи (https://logs.<SITE_DOMAIN>) ---
# Второй адрес мониторинга: живой поток логов контейнеров через Dozzle.
# Хеш тот же, что у мониторинга (пароль общий, логин свой), и копия эта нужна
# только для проверок деплоя и для человека: вход проверяет Caddy основного
# стека, он читает корневой .env, а не этот файл.
LOGS_HOST=logs.dmv-crm.ru
LOGS_BASIC_AUTH_USER=logs
LOGS_BASIC_AUTH_HASH=$$2a$$14$$nduRAFlYpbDebxcIGa2oveoXKJswEHWAV8vFTVWn.HXKmBjZADkmy

# --- Стенд отдела: порты для браузера (monitor/docker-compose.local.yml) ---
# Только локально. На сервере этот файл не применяется, и у стека нет ни одного
# опубликованного порта: вход один, https://monitor.<домен> через Caddy.
# Порт Grafana на стенде.
MONITOR_GRAFANA_PORT=8095
# Порт живого просмотра логов (Dozzle) на стенде.
MONITOR_LOGS_PORT=8096

# Учётная запись Grafana: после basic auth Caddy нужен ещё и вход в саму
# Grafana. Пароль на бою генерирует деплой мониторинга.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=monitor-stand-only-change-me

# --- Уведомления ---
# Бот и чат для алертов и вечерней сводки. Пустой токен — рабочее состояние:
# сообщения уходят в лог контейнера notifier (docs/monitoring.md).
MONITOR_TELEGRAM_BOT_TOKEN=
MONITOR_TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE_URL=https://api.telegram.org

# --- Сбор метрик ---
# Сколько дней Prometheus хранит историю. Диск на сервере общий с боевой базой.
PROMETHEUS_RETENTION=15d
# Второй предел хранения — размер: при всплеске числа серий история упирается в
# диск раньше, чем в 15 дней. 1 ГБ важнее длинной истории.
PROMETHEUS_RETENTION_SIZE=1GB
# Откуда notifier берёт цифры для сводки: внутренний адрес Prometheus.
PROMETHEUS_URL=http://prometheus:9090
# Час вечерней сводки и её часовой пояс.
DIGEST_HOUR=18
DIGEST_TIMEZONE=Europe/Moscow
TZ=Europe/Moscow

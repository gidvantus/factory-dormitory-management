{
	# Почта для писем об истечении сертификата (ACME принимает только ASCII).
	email {$ACME_EMAIL}
	# ACME-директория: боевая по умолчанию, staging — через .env.
	acme_ca {$CADDY_ACME_CA}
	# Автоматический редирект HTTP→HTTPS выключен: редирект делает блок :80
	# ниже, иначе /healthz получает 308 вместо 200.
	auto_https disable_redirects
}

# ---- HTTP (порт 80): /healthz отвечает 200 без редиректа, остальное — на https ----
:80 {
	# route — строгий порядок: сначала /healthz, только потом редирект.
	route {
		@healthz path /healthz
		respond @healthz "ok" 200
		# Кабинет оператора — тоже наш хост: без него http://operator.<домен>/…
		# улетал бы на канонический домен, то есть в чужой кабинет.
		@ourhost host {$SITE_DOMAIN} www.{$SITE_DOMAIN} operator.{$SITE_DOMAIN}
		redir @ourhost https://{host}{uri} permanent
		# Запросы по IP и чужому Host — на канонический домен: сертификата на IP не бывает.
		redir https://{$SITE_DOMAIN}{uri} permanent
	}
}

# ---- Домен: SPA и /api (nginx фронта проксирует /api на api:8000) ----
{$SITE_DOMAIN}, www.{$SITE_DOMAIN} {
	encode zstd gzip
	reverse_proxy web:80
}

# ---- Кабинет оператора: отдельный поддомен ----
# Отдельный хост, а не путь на основном домене, потому что cookie
# `operator_session` ставится host-only: на своём поддомене она не
# пересекается с `crm_session` основного кабинета.
# Имя собирается из SITE_DOMAIN намеренно: новая обязательная переменная —
# ещё один способ уронить конфиг (а вместе с ним и основной кабинет) опечаткой.
# Публикация кабинета на 127.0.0.1:8082 остаётся резервом для SSH-туннеля.
operator.{$SITE_DOMAIN} {
	encode zstd gzip
	reverse_proxy operator-web:80
}
